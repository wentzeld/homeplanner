# systemd *user* service for the HomePlanner backend.
# install.sh copies this to ~/.config/systemd/user/ and replaces @APP_DIR@.
[Unit]
Description=HomePlanner family calendar backend

[Service]
WorkingDirectory=@APP_DIR@
Environment=HOMEPLANNER_CONFIG=@APP_DIR@/config.toml
Environment=HOMEPLANNER_SCREEN_CONTROL=1
# Let phones/laptops on the home network in, behind a PIN set on the display (see auth.py).
# To keep HomePlanner private to the Pi: remove this line and use --host 127.0.0.1 below.
Environment=HOMEPLANNER_REMOTE=1
# Lets wlr-randr reach the desktop's Wayland compositor (labwc) to switch the screen off/on.
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=WAYLAND_DISPLAY=wayland-0
# --no-proxy-headers: the display is recognised by its 127.0.0.1 address; never trust forwarded headers.
ExecStart=@APP_DIR@/.venv/bin/uvicorn homeplanner.main:app --host 0.0.0.0 --port 8000 --no-proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
